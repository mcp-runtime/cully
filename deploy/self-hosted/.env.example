# cully setup saves generated database passwords and service tokens in ~/.cully/config.json.
# This file contains only deployment options. Setup passes private credentials to Docker Compose.
# OAuth applies only to MCP. Set these values before cully setup --all --oauth.
CULLY_MCP_HOST=mcp.example.com
CULLY_AUTH_HOST=auth.example.com
MCP_AUTH_UPSTREAM_CLIENT_SECRET=replace-with-upstream-client-secret
